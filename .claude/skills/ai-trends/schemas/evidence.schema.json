{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-trends 证据对象",
  "type": "object",
  "required": [
    "id",
    "title",
    "url",
    "published_at",
    "source_tier",
    "verification_status",
    "claims",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "规范化 URL 的 sha1 前 16 位"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "published_at": {
      "type": ["string", "null"],
      "description": "YYYY-MM-DD；无法确认时为 null 并标注未核实"
    },
    "source_tier": {
      "type": "string",
      "enum": ["A", "B", "C"]
    },
    "kind": {
      "type": "string",
      "enum": ["model", "research", "product", "company", "policy", "safety", "community", "ecosystem", "hardware"]
    },
    "verification_status": {
      "type": "string",
      "enum": ["primary_verified", "corroborated", "unverified", "disputed", "refuted"]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "source_url"],
        "properties": {
          "text": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "quote": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "tier"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "tier": { "type": "string", "enum": ["A", "B", "C"] },
          "role": { "type": "string", "enum": ["primary", "independent", "context"] },
          "fetched_at": { "type": "string" }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
